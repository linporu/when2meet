parameters:
    paths:
        - app
        - database
        - routes
        - tests
    
    level: 6
    
    ignoreErrors:
        - '#Undefined variable: \$this#'
        - '#Call to an undefined method PHPUnit\\Framework\\TestCase::#'
        - '#Function something\(\) has no return type specified#'
    
    excludePaths:
        - bootstrap/*
        - storage/*
        - vendor/*
        - node_modules/*
        - '*/cache/*'
    
    bootstrapFiles:
        - vendor/autoload.php
        
    parallel:
        maximumNumberOfProcesses: 32